{
  "name": "startup-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev --port 3100",
    "dev:backend": "convex dev",
    "dev:local": "tsx scripts/dev/local.ts",
    "dev:seed": "tsx scripts/dev/seed.ts",
    "dev:signin": "tsx scripts/dev/signin.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\" --ignore-pattern \".vercel/**\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "push:retention": "tsx scripts/push-retention.ts",
    "register:headers": "tsx scripts/register-headers.ts",
    "push:customers": "tsx scripts/push-customers.ts",
    "import:prospects": "tsx scripts/import-prospects.ts",
    "import:intel": "tsx scripts/import-intel.ts",
    "push:envelope": "tsx scripts/push-envelope.ts",
    "support:envelope": "tsx scripts/support-envelope.ts",
    "standup:open": "tsx scripts/standup-open.ts",
    "standup:push": "tsx scripts/standup-push.ts",
    "visible:outbox": "tsx scripts/visible-outbox.ts",
    "visible:ack": "tsx scripts/visible-ack.ts",
    "gather:github": "tsx scripts/gather-github.ts",
    "assistant:runner": "tsx scripts/assistant-runner.ts",
    "gen:agent-docs": "tsx scripts/gen-os-agent-docs.ts",
    "assistant:runner:install": "tsx scripts/assistant-runner-install.ts install",
    "assistant:runner:uninstall": "tsx scripts/assistant-runner-install.ts uninstall"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "convex-helpers": "^0.1.128",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.38",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
